# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp output files
tsc-out.txt
build-out.txt
build-err.txt
test30-out.txt
check_db.js
_part*.txt
_dp*.txt
_mv*.txt

# prisma
/src/generated/prisma

# kilo agent scratch workspace
/.kilo

# dev artifacts
__shot_urdu.html
login_test.py
*_diag_*.ts

# HTTP/session dumps - auth artifacts must NEVER be committed
cookies*.txt
*.cookiejar
post_body*.txt
session-dump*.*

# pg_dump / maintenance backups (may contain business data)
*.sql
!prisma/migrations/**/*.sql

# agent / IDE internal workspace (not project code)
/.workbuddy-ai/

# local scratch workspace
/scratch/

# Local runtime logs
*.log

# dev output / scratch logs
*_err.txt
*_out.txt
ports.txt