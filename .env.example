# ===================================================================
# DukaanOS v1.0.0 — Production Environment Configuration Template
# ===================================================================
# Copy this file to `.env` and supply actual production values.
# NEVER commit your actual `.env` file containing secrets to version control.
# This file documents all environment variables with placeholders only.
# ===================================================================

# -------------------------------------------------------------------
# 1. Database — PostgreSQL 16+
#    Connection string with credentials. Use sslmode=require for TLS.
#    Generate: standard PostgreSQL connection URI.
# -------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dukaanos?schema=public&sslmode=require"

# -------------------------------------------------------------------
# 2. Authentication Secrets (NextAuth v5 / Auth.js)
#    Generate a strong 32-byte secret:
#      openssl rand -base64 32
# -------------------------------------------------------------------
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# The canonical base URL used for callbacks and redirect URLs.
# Must be an https:// URL in production (e.g. https://app.dukaanos.com).
NEXTAUTH_URL="https://app.dukaanos.com"

# -------------------------------------------------------------------
# 3. Application Public URL
#    Used for sitemap, robots, PWA, and absolute link generation.
#    If APP_URL is unset, NEXT_PUBLIC_APP_URL is used as fallback.
# -------------------------------------------------------------------
APP_URL="https://app.dukaanos.com"
NEXT_PUBLIC_APP_URL="https://app.dukaanos.com"

# -------------------------------------------------------------------
# 4. Scheduled Maintenance Cron Secret
#    Protects the POST /api/cron maintenance endpoint.
#    Generate a strong secret:
#      openssl rand -hex 32
#    Trigger externally every 15 minutes:
#      curl -X POST https://app.dukaanos.com/api/cron \
#        -H "Authorization: Bearer <CRON_SECRET>"
# -------------------------------------------------------------------
CRON_SECRET="replace-with-openssl-rand-hex-32"

# -------------------------------------------------------------------
# 5. Web Push Notification Keys (VAPID)
#    Generate using:
#      npx web-push generate-vapid-keys
#    Server Public Key (sent to browser).
#    Server Private Key (kept on server only — never expose to client).
# -------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:support@dukaanos.com"

# -------------------------------------------------------------------
# 6. Runtime & Process Settings
# -------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# -------------------------------------------------------------------
# 7. Communication Provider Variables (Optional)
#    These are used to seed/configure default communication providers
#    per business. Leave unset to use the built-in MockCommunicationProvider
#    for development. In production, configure per-business via the
#    dashboard settings UI.
# -------------------------------------------------------------------
# Twilio (SMS / WhatsApp)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
# TWILIO_FROM_NUMBER="+1234567890"
# TWILIO_WHATSAPP_FROM="whatsapp:+1234567890"

# Email provider (SMTP / Resend / SendGrid / Brevo)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user@example.com"
# SMTP_PASS="replace-with-smtp-password"
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# SENDGRID_API_KEY="SG.xxxxx"
# BREVO_API_KEY="xkeysib-xxxxx"

# -------------------------------------------------------------------
# 8. Storage / Media (Optional)
#    For future avatar/logo upload support. Currently logos are stored
#    as URLs in BusinessSetting.logoUrl.
# -------------------------------------------------------------------
# UPLOADTHING_TOKEN="sk_live_xxxxx"
# SUPABASE_URL="https://xxxxx.supabase.co"
# SUPABASE_ANON_KEY="xxxxx"

# -------------------------------------------------------------------
# 9. Analytics / Telemetry (Optional)
#    DukaanOS includes a privacy-first ProductAnalyticsEvent table.
#    No third-party analytics keys are required.
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# 10. Bootstrap Credentials (Optional)
#    Used only for initial one-time owner bootstrap via
#    `npm run bootstrap`. Remove or rotate after provisioning.
# -------------------------------------------------------------------
# BOOTSTRAP_OWNER_EMAIL="owner@example.com"
# BOOTSTRAP_OWNER_PASSWORD="TempPass123!"
# BOOTSTRAP_OWNER_NAME="Store Owner"
# BOOTSTRAP_STORE_NAME="Main Retail Store"

# -------------------------------------------------------------------
# 11. Logging & Observability (Optional)
# -------------------------------------------------------------------
# LOG_LEVEL="info"  # debug | info | warn | error
# SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"  # Reserved for future use

# -------------------------------------------------------------------
# 12. Rate Limiting & Security (Optional)
# -------------------------------------------------------------------
# RATE_LIMIT_STRATEGY="memory"  # memory | redis
# REDIS_URL="redis://localhost:6379"  # Required if RATE_LIMIT_STRATEGY=redis
