generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------
// Auth.js Models & User
// ----------------------------------------
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  
  accounts      Account[]
  sessions      Session[]
  memberships   BusinessMembership[]
  auditLogs     AuditLog[]
  notificationsReceived Notification[]
  employeeProfiles Employee[]
  conversationParticipants ConversationParticipant[]
  messagesSent Message[]
  announcementsAuthored Announcement[]
  announcementReads AnnouncementRead[]
  pushSubscriptions PushSubscription[]
  notificationPreferences NotificationPreference[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ----------------------------------------
// Tenancy & Hierarchy
// ----------------------------------------
enum BusinessType {
  RETAIL
  WHOLESALE
  SERVICES
  OTHER
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Business {
  id          String         @id @default(uuid())
  name        String
  type        BusinessType   @default(RETAIL)
  status      BusinessStatus @default(ACTIVE)
  
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String?
  timezone    String         @default("Asia/Karachi")
  currency    String         @default("PKR")
  isOpen      Boolean        @default(true)
  operatingHours String?

  memberships   BusinessMembership[]
  branches      Branch[]
  categories    Category[]
  products      Product[]
  suppliers     Supplier[]
  customers     Customer[]
  purchases     Purchase[]
  sales         Sale[]
  expenses      Expense[]
  movements     StockMovement[]
  payments      CustomerPayment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  employees     Employee[]
  attendances   EmployeeAttendance[]
  leaves        EmployeeLeave[]
  salaries      EmployeeSalary[]
  complaints    EmployeeComplaint[]
  feedbacks     CustomerFeedback[]
  feedbackInvites FeedbackInviteToken[]
  conversations Conversation[]
  messages      Message[]
  announcements Announcement[]
  pushSubscriptions PushSubscription[]
  notificationPreferences NotificationPreference[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  code        String
  address     String?
  phone       String?
  city        String?
  timezone    String   @default("Asia/Karachi")
  status      BusinessStatus @default(ACTIVE)

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  sales       Sale[]
  purchases   Purchase[]
  movements   StockMovement[]
  expenses    Expense[]
  employees   Employee[]
  attendances EmployeeAttendance[]
  announcements Announcement[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, code])
}

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
  EMPLOYEE
}

model BusinessMembership {
  id         String         @id @default(uuid())
  userId     String
  businessId String
  role       MembershipRole @default(EMPLOYEE)
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, businessId])
}

// ----------------------------------------
// Catalog & Inventory
// ----------------------------------------
model Category {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean  @default(true)

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, name])
}

model Supplier {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?  @db.Text
  isActive    Boolean  @default(true)

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases   Purchase[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                String   @id @default(uuid())
  businessId        String
  categoryId        String?
  name              String
  sku               String?
  barcode           String?
  description       String?  @db.Text
  unit              String   @default("pcs")
  
  // Money represented as Decimal (12, 2)
  purchasePrice     Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal  @default(0) @db.Decimal(12, 2)
  
  // Aggregate cache, backed by StockMovement ledger
  currentStock      Int      @default(0)
  minStockThreshold Int      @default(5)
  
  isActive          Boolean  @default(true)

  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  movements         StockMovement[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  LOSS
  TRANSFER
}

model StockMovement {
  id               String       @id @default(uuid())
  businessId       String
  branchId         String?
  productId        String
  movementType     MovementType
  quantity         Int          // Positive for incoming, Negative for outgoing
  previousStock    Int
  resultingStock   Int
  referenceId      String?      // Can point to Sale ID, Purchase ID, etc.
  notes            String?
  
  createdBy        String?

  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt        DateTime @default(now())
}

// ----------------------------------------
// Customers & Udhaar (Credit)
// ----------------------------------------
enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Customer {
  id          String         @id @default(uuid())
  businessId  String
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?        @db.Text
  status      CustomerStatus @default(ACTIVE)
  
  // Aggregate customer balance for quick reads
  // Credit = Positive, Advance/Overpaid = Negative
  outstanding Decimal        @default(0) @db.Decimal(12, 2)
  
  isActive    Boolean        @default(true)

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales       Sale[]
  payments    CustomerPayment[]
  feedbacks   CustomerFeedback[]
  feedbackInvites FeedbackInviteToken[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([businessId, phone])
  @@index([businessId, status])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  CREDIT
}

model CustomerPayment {
  id          String        @id @default(uuid())
  businessId  String
  customerId  String
  saleId      String?       // Optional, if payment is directly against a specific sale
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(CASH)
  date        DateTime      @default(now())
  notes       String?
  createdBy   String?

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------
// Transactions: Sales
// ----------------------------------------
enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

model Sale {
  id            String        @id @default(uuid())
  businessId    String
  branchId      String?
  customerId    String?
  
  invoiceNumber String
  saleDate      DateTime      @default(now())
  
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  
  paymentMethod PaymentMethod @default(CASH)
  status        SaleStatus    @default(COMPLETED)
  createdBy     String?
  clientTransactionId String? // Idempotent key for offline/queued transactions

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  items         SaleItem[]
  payments      CustomerPayment[]
  feedbacks     CustomerFeedback[]
  feedbackInvites FeedbackInviteToken[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId, saleDate])
  @@index([businessId, clientTransactionId])
}

model SaleItem {
  id            String   @id @default(uuid())
  saleId        String
  productId     String
  
  quantity      Int
  
  // Historical snapshot at time of sale
  sellingPrice  Decimal  @db.Decimal(12, 2)
  costPrice     Decimal  @db.Decimal(12, 2) // Essential for historical profit calculation
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)
  lineProfit    Decimal  @db.Decimal(12, 2)

  sale          Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict) // Do not delete products if they have sale history
}

// ----------------------------------------
// Transactions: Purchases
// ----------------------------------------
enum PurchaseStatus {
  RECEIVED
  CANCELLED
}

model Purchase {
  id            String        @id @default(uuid())
  businessId    String
  branchId      String?
  supplierId    String?
  
  invoiceNumber String?
  purchaseDate  DateTime      @default(now())
  
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  
  status        PurchaseStatus @default(RECEIVED)
  notes         String?
  createdBy     String?

  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  
  items         PurchaseItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([businessId, purchaseDate])
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchaseId    String
  productId     String
  
  quantity      Int
  
  // Historical snapshot at time of purchase
  purchasePrice Decimal  @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)

  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// ----------------------------------------
// Finance: Expenses
// ----------------------------------------
model Expense {
  id            String   @id @default(uuid())
  businessId    String
  branchId      String?
  category      String   // Kept as string to allow owner customization
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now())
  description   String?
  paymentMethod PaymentMethod @default(CASH)
  createdBy     String?

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([businessId, date])
}

// ----------------------------------------
// Communication & Audit
// ----------------------------------------
enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
  ALERT
}

model Notification {
  id               String               @id @default(uuid())
  businessId       String
  recipientId      String?              // Specific user, or null for all owners/managers
  type             String
  severity         NotificationSeverity @default(INFO)
  title            String
  message          String               @db.Text
  isOwnerOnly      Boolean              @default(false)
  isRead           Boolean              @default(false)
  actionUrl        String?
  
  relatedEntity    String?              // e.g., "PRODUCT", "SALE"
  relatedEntityId  String?
  deduplicationKey String?

  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipient        User?    @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  readAt           DateTime?

  @@index([businessId, recipientId, isRead])
  @@index([businessId, deduplicationKey])
}

model PushSubscription {
  id          String   @id @default(uuid())
  userId      String
  businessId  String?
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceLabel String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@index([businessId, isActive])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String
  businessId       String
  lowStockAlerts   Boolean  @default(true)
  salesDropAlerts  Boolean  @default(true)
  profitAlerts     Boolean  @default(true)
  creditAlerts     Boolean  @default(true)
  expenseAlerts    Boolean  @default(true)
  feedbackAlerts   Boolean  @default(true)
  employeeAlerts   Boolean  @default(true)
  messagesAlerts   Boolean  @default(true)
  dailyDigest      Boolean  @default(true)
  dailyDigestTime  String   @default("09:00")
  webPushEnabled   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId, userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String
  branchId    String?
  userId      String?
  action      String   // e.g., SALE_CREATED, PRODUCT_UPDATED
  entityType  String
  entityId    String
  metadata    String?  @db.Text // Stored as JSON string
  ipAddress   String?
  
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  
  @@index([businessId, action])
  @@index([businessId, createdAt])
}

// ----------------------------------------
// Human Resources: Employee Management
// ----------------------------------------
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
}

enum SalaryPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Employee {
  id                String         @id @default(uuid())
  businessId        String
  branchId          String?
  userId            String?        // Optional login account link
  
  employeeCode      String         // e.g., EMP-001
  name              String
  phone             String?
  email             String?
  address           String?
  position          String         // e.g., "Cashier", "Sales Associate", "Manager", "Storekeeper"
  department        String?        // e.g., "Sales", "Operations", "Inventory"
  joiningDate       DateTime       @default(now())
  
  salaryType        SalaryType     @default(MONTHLY)
  basicSalary       Decimal        @default(0) @db.Decimal(12, 2)
  status            EmployeeStatus @default(ACTIVE)
  notes             String?        @db.Text

  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  attendances       EmployeeAttendance[]
  leaves            EmployeeLeave[]
  salaries          EmployeeSalary[]
  complaints        EmployeeComplaint[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([businessId, employeeCode])
  @@index([businessId, status])
}

model EmployeeAttendance {
  id          String           @id @default(uuid())
  businessId  String
  employeeId  String
  branchId    String?
  
  date        DateTime         // Calendar day (00:00:00 UTC boundary)
  status      AttendanceStatus @default(PRESENT)
  checkIn     DateTime?
  checkOut    DateTime?
  notes       String?
  recordedBy  String?          // User ID

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([businessId, employeeId, date])
  @@index([businessId, date])
}

model EmployeeLeave {
  id            String      @id @default(uuid())
  businessId    String
  employeeId    String
  
  leaveType     LeaveType   @default(CASUAL)
  startDate     DateTime
  endDate       DateTime
  daysCount     Int         @default(1)
  reason        String      @db.Text
  status        LeaveStatus @default(PENDING)
  
  approvedBy    String?     // User ID
  approvalNotes String?

  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId, status])
}

model EmployeeSalary {
  id            String              @id @default(uuid())
  businessId    String
  employeeId    String
  
  period        String              // e.g., "2026-08"
  baseSalary    Decimal             @db.Decimal(12, 2)
  overtime      Decimal             @default(0) @db.Decimal(12, 2)
  bonus         Decimal             @default(0) @db.Decimal(12, 2)
  deductions    Decimal             @default(0) @db.Decimal(12, 2)
  advance       Decimal             @default(0) @db.Decimal(12, 2)
  netSalary     Decimal             @db.Decimal(12, 2)
  
  paymentStatus SalaryPaymentStatus @default(PENDING)
  paymentDate   DateTime?
  paymentMethod PaymentMethod       @default(CASH)
  notes         String?             @db.Text
  recordedBy    String?             // User ID

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([businessId, employeeId, period])
  @@index([businessId, period])
}

model EmployeeComplaint {
  id              String            @id @default(uuid())
  businessId      String
  employeeId      String
  
  title           String
  category        String            // "WORKPLACE", "HARASSMENT", "PAYROLL", "SAFETY", "OTHER"
  description     String            @db.Text
  priority        ComplaintPriority @default(MEDIUM)
  status          ComplaintStatus   @default(OPEN)
  
  submittedBy     String?           // User ID or name
  resolutionNote  String?           @db.Text
  resolvedBy      String?           // User ID
  resolvedAt      DateTime?

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([businessId, status])
}

// ----------------------------------------
// Customer Experience & Feedback (Step 11)
// ----------------------------------------
enum FeedbackCategory {
  SERVICE
  PRODUCT
  PRICE
  STAFF
  CLEANLINESS
  DELIVERY
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWING
  RESOLVED
  ARCHIVED
}

model CustomerFeedback {
  id             String           @id @default(uuid())
  businessId     String
  customerId     String?
  saleId         String?
  
  rating         Int              // 1 to 5 stars
  category       FeedbackCategory @default(SERVICE)
  message        String           @db.Text
  isAnonymous    Boolean          @default(false)
  
  status         FeedbackStatus   @default(NEW)
  resolutionNote String?          @db.Text
  resolvedBy     String?          // User ID of manager
  resolvedAt     DateTime?
  
  token          String?          @unique // Secure invite token if linked
  
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale           Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([businessId, status])
  @@index([businessId, rating])
  @@index([businessId, createdAt])
}

model FeedbackInviteToken {
  id          String    @id @default(uuid())
  businessId  String
  customerId  String?
  saleId      String?
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([businessId, createdAt])
}

// ----------------------------------------
// Internal Communication & Announcements (Step 12)
// ----------------------------------------
enum ConversationType {
  DIRECT
  GROUP
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementTargetRole {
  ALL
  OWNER
  MANAGER
  CASHIER
  EMPLOYEE
}

model Conversation {
  id           String                   @id @default(uuid())
  businessId   String
  type         ConversationType         @default(DIRECT)
  title        String?                  // Optional group name
  createdBy    String?                  // User ID

  business     Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([businessId, updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  isActive       Boolean      @default(true)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(uuid())
  businessId     String
  conversationId String
  senderId       String
  content        String       @db.Text
  deletedAt      DateTime?

  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, createdAt])
  @@index([businessId, createdAt])
}

model Announcement {
  id          String                 @id @default(uuid())
  businessId  String
  branchId    String?
  authorId    String
  title       String
  message     String                 @db.Text
  priority    AnnouncementPriority   @default(NORMAL)
  targetRole  AnnouncementTargetRole @default(ALL)
  expiresAt   DateTime?
  isArchived  Boolean                @default(false)

  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  author      User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads       AnnouncementRead[]

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([businessId, isArchived, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, announcementId])
}



